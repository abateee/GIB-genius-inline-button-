{
  "manifest_version": 3,
  "name": "Genius Inline Button",
  "version": "1.2.0",
  "description": "Adds a Genius button next to the current song title on YouTube, YouTube Music, and Spotify Web.",
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "genius-inline-button@abateee",
      "strict_min_version": "121.0"
    }
  },
  "icons": {
    "16": "icons/genius-16.png",
    "32": "icons/genius-32.png",
    "48": "icons/genius-48.png",
    "128": "icons/genius-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "lib/parse.js",
      "lib/match.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://music.youtube.com/*",
        "*://open.spotify.com/*"
      ],
      "js": [
        "lib/parse.js",
        "lib/match.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://music.youtube.com/*",
    "*://open.spotify.com/*",
    "https://genius.com/*"
  ]
}
