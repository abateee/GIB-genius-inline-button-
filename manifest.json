{
  "manifest_version": 3,
  "name": "Genius Inline Button",
  "version": "1.0.1",
  "description": "Adds a Genius button next to the current song title on YouTube, YouTube Music, and Spotify Web.",
  "icons": {
    "16": "icons/genius-16.png",
    "32": "icons/genius-32.png",
    "48": "icons/genius-48.png",
    "128": "icons/genius-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://music.youtube.com/*",
        "*://open.spotify.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://music.youtube.com/*",
    "*://open.spotify.com/*"
  ]
}